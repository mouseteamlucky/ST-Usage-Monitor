+/**
+ * dsh-usage-monitor: short fingerprint of the outgoing message payload.
+ * Two requests with the same hash sent the exact same prompt
+ * (i.e. a re-roll / swipe of the same turn, not a new turn).
+ * @param {Array<{role?: string, content?: any}>} messages Outgoing messages
+ * @returns {string|null} 12 hex chars, or null when not computable
+ */
+export function hashPromptPayload(messages) {
+    try {
+        if (!Array.isArray(messages) || messages.length === 0) {
+            return null;
+        }
+        const hash = crypto.createHash('sha1');
+        for (const message of messages) {
+            hash.update(String((message && message.role) || ''));
+            hash.update('\u0000');
+            const content = message && message.content;
+            hash.update(typeof content === 'string' ? content : JSON.stringify(content ?? ''));
+            hash.update('\u0001');
+        }
+        return hash.digest('hex').slice(0, 12);
+    } catch {
+        return null;
+    }
+}
+
+/**
+ * dsh-usage-monitor: capture is enabled when ST_USAGE_CAPTURE=1 is set OR a flag file
+ * (st-usage.capture) exists in the user's data root. The flag file allows toggling the
+ * monitor on/off without restarting the server.
+ * @param {string} userRoot Path to the user's data root
+ * @returns {boolean} True when usage capture is enabled
+ */
+export function isUsageCaptureEnabled(userRoot) {
+    if (process.env.ST_USAGE_CAPTURE === '1') {
+        return true;
+    }
+    try {
+        return Boolean(userRoot) && fs.existsSync(path.join(userRoot, 'st-usage.capture'));
+    } catch {
+        return false;
+    }
+}
+
+export async function forwardFetchResponseCapture(from, to, meta) {
+    const usageLogPath = meta && meta.usageLogPath;
+    const debugLogPath = usageLogPath ? usageLogPath + '.debug.log' : null;
+    const dbg = (msg) => {
+        if (!debugLogPath) return;
+        try { fs.appendFileSync(debugLogPath, new Date().toISOString() + ' [capture] ' + msg + '\n', 'utf8'); } catch { /* ignore */ }
+    };
+    dbg('start status=' + from.status + ' model=' + ((meta && meta.model) || '') + ' n_msgs=' + ((meta && meta.n_msgs) ?? '?') + ' stream=' + ((meta && meta.stream) ?? '?'));
+    let statusCode = from.status;
+    let statusText = from.statusText;
+
+    if (statusCode === 401) {
+        statusCode = 400;
+        statusText = 'Bad Request';
+    }
+
+    to.statusCode = statusCode;
+    to.statusMessage = statusText;
+
+    if (!from.ok) {
+        try {
+            const rawErrorText = await from.text();
+            console.warn('[usage-mon] upstream_error ' + from.status + ' ' + String(rawErrorText || '').slice(0, 200));
+            to.end(rawErrorText, 'utf-8');
+        } catch (e) {
+            to.end();
+        }
+        return;
+    }
+
+    if (!from.body) {
+        to.end();
+        return;
+    }
+
+    return new Promise(function (resolve, reject) {
+        let raw = '';
+        from.body.on('data', function (chunk) {
+            try {
+                to.write(chunk);
+            } catch (e) { /* ignore */ }
+            raw += chunk.toString('utf8');
+        });
+        from.body.on('end', function () {
+            try {
+                to.end();
+            } catch (e) { /* ignore */ }
+            try {
+                const rec = parseUsageRecord(raw, meta);
+                if (rec && usageLogPath) {
+                    fs.appendFileSync(usageLogPath, JSON.stringify(rec) + '\n', 'utf8');
+                    console.info('[usage-mon] record hit=' + rec.hit + ' miss=' + rec.miss + ' prompt=' + rec.prompt + ' completion=' + rec.completion + ' file=' + (rec.file || ''));
+                    dbg('end bytes=' + raw.length + ' parsed=yes hit=' + rec.hit + ' miss=' + rec.miss + ' prompt=' + rec.prompt);
+                } else {
+                    dbg('end bytes=' + raw.length + ' parsed=NO tail=' + JSON.stringify(String(raw).slice(-240)));
+                }
+            } catch (e) {
+                console.warn('[usage-mon] parse_failed', String((e && e.message) || e));
+            }
+            resolve();
+        });
+        from.body.on('error', function (e) {
+            try {
+                to.end();
+            } catch (err) { /* ignore */ }
+            reject(e);
+        });
+    });
+}
+
+function parseUsageRecord(raw, meta) {
+    if (!raw) return null;
+    let hit = tryNum(/prompt_cache_hit_tokens"?\s*:\s*(\d+)/.exec(raw));
+    let miss = tryNum(/prompt_cache_miss_tokens"?\s*:\s*(\d+)/.exec(raw));
+    const prompt = tryNum(/"prompt_tokens"?\s*:\s*(\d+)/.exec(raw));
+    const completion = tryNum(/"completion_tokens"?\s*:\s*(\d+)/.exec(raw));
+    const total = tryNum(/"total_tokens"?\s*:\s*(\d+)/.exec(raw));
+    if (prompt === null && hit === null && miss === null && total === null) return null;
+    // OpenAI-compat: cached_tokens inside prompt_tokens_details
+    let cached = tryNum(/"cached_tokens"\s*:\s*(\d+)/.exec(raw));
+    if (cached !== null && miss === null && prompt !== null) {
+        miss = Math.max(prompt - cached, 0);
+    }
+    if (hit === null && cached !== null) {
+        hit = cached;
+    }
+    // keep a short raw snippet of the usage object for forensics
+    let usageRaw = null;
+    const um = /"usage"\s*:\s*(\{[^}]{0,700})/.exec(raw);
+    if (um) usageRaw = um[1].slice(0, 700);
+    return {
+        t: new Date().toISOString(),
+        source: meta && meta.source,
+        model: meta && meta.model,
+        endpoint: meta && meta.endpoint,
+        file: meta && meta.file,
+        n_msgs: meta && meta.n_msgs,
+        payload_hash: meta && meta.payload_hash,
+        stream: meta && meta.stream,
+        max_tokens: meta && meta.max_tokens,
+        hit: hit,
+        miss: miss,
+        cached: cached,
+        prompt: prompt,
+        completion: completion,
+        total: total,
+        usage_raw: usageRaw,
+    };
+}
+
+function tryNum(m) {
+    return m && m[1] !== undefined && /^\d+$/.test(m[1]) ? Number(m[1]) : null;
+}
